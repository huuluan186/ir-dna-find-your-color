# Supabase (Settings → API). Chỉ dùng ở server, không thêm tiền tố NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi ngẫu nhiên ≥ 32 ký tự, ký cookie phiên
SESSION_SECRET=

# Mật khẩu chung của nhóm tổ chức
ADMIN_PASSWORD=

# Link chính thức, dùng để sinh mã QR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chuỗi kết nối Postgres (Supabase → Connect → Session pooler), dùng để chạy migration
DB_URL=
